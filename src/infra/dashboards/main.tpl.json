            "type": "text",
            "properties": {
                "markdown": "## Email Outcome per Tenant (SES)\n"
            }
        }%{ if length(tenants) > 0 },%{ endif ~}
%{ for i, tenant_key in keys(tenants) ~}
        {
            "height": 1,
            "width": 24,
            "y": ${63 + i * 7},
            "x": 0,
            "type": "text",
            "properties": {
                "markdown": "### ${tenants[tenant_key].tenant_name}"
            }
        },
        {
            "height": 6,
            "width": 12,
            "y": ${64 + i * 7},
            "x": 0,
            "type": "metric",
            "properties": {
                "view": "timeSeries",
                "stacked": true,
                "metrics": [
                    [ { "expression": "SEARCH('{${namespace},service,tenantName,clientId} MetricName=\"EmailDelivered\" service=\"${csp_service}\" tenantName=\"${tenants[tenant_key].tenant_name}\"', 'Sum', 300)", "label": "Delivered", "id": "delivered_${tenant_key}", "region": "${aws_region}" } ],
                    [ { "expression": "SEARCH('{${namespace},service,tenantName,clientId} MetricName=\"EmailHardBounce\" service=\"${csp_service}\" tenantName=\"${tenants[tenant_key].tenant_name}\"', 'Sum', 300)", "label": "HardBounce", "id": "hardbounce_${tenant_key}", "region": "${aws_region}" } ],
                    [ { "expression": "SEARCH('{${namespace},service,tenantName,clientId} MetricName=\"EmailRejected\" service=\"${csp_service}\" tenantName=\"${tenants[tenant_key].tenant_name}\"', 'Sum', 300)", "label": "Rejected", "id": "rejected_${tenant_key}", "region": "${aws_region}" } ],
                    [ { "expression": "SEARCH('{${namespace},service,tenantName,clientId} MetricName=\"EmailComplaint\" service=\"${csp_service}\" tenantName=\"${tenants[tenant_key].tenant_name}\"', 'Sum', 300)", "label": "Complaint", "id": "complaint_${tenant_key}", "region": "${aws_region}" } ],
                    [ { "expression": "SEARCH('{${namespace},service,tenantName,clientId} MetricName=\"EmailRenderingFailure\" service=\"${csp_service}\" tenantName=\"${tenants[tenant_key].tenant_name}\"', 'Sum', 300)", "label": "RenderingFailure", "id": "renderfail_${tenant_key}", "region": "${aws_region}" } ]
                ],
                "region": "${aws_region}",
                "period": 300,
                "title": "Delivery vs Failures - ${tenants[tenant_key].tenant_name}"
            }
        },
        {
            "height": 6,
            "width": 12,
            "y": ${64 + i * 7},
            "x": 12,
            "type": "metric",
            "properties": {
                "view": "timeSeries",
                "stacked": false,
                "metrics": [
                    [ { "expression": "SEARCH('{${namespace},service,tenantName,clientId} MetricName=\"EmailNonRetryableSoftBounce\" service=\"${csp_service}\" tenantName=\"${tenants[tenant_key].tenant_name}\"', 'Sum', 300)", "label": "NonRetryableSoftBounce", "id": "nonretry_${tenant_key}", "region": "${aws_region}" } ],
                    [ { "expression": "SEARCH('{${namespace},service,tenantName,clientId} MetricName=\"HighPriorityMaxRetriesReached\" service=\"${csp_service}\" tenantName=\"${tenants[tenant_key].tenant_name}\"', 'Sum', 300)", "label": "HighPriorityMaxRetries", "id": "hipri_${tenant_key}", "region": "${aws_region}" } ],
                    [ { "expression": "SEARCH('{${namespace},service,tenantName,clientId} MetricName=\"LowPriorityMaxRetriesReached\" service=\"${csp_service}\" tenantName=\"${tenants[tenant_key].tenant_name}\"', 'Sum', 300)", "label": "LowPriorityMaxRetries", "id": "lopri_${tenant_key}", "region": "${aws_region}" } ]
                ],
                "region": "${aws_region}",
                "period": 300,
                "title": "Bounce & Retry Exhausted - ${tenants[tenant_key].tenant_name}"
            }
        }%{ if i < length(tenants) - 1 },%{ endif ~}
%{ endfor ~}
    ]
}
