                "stacked": false,
                "region": "${aws_region}",
                "stat": "Maximum",
                "period": 60,
                "metrics": [
                    [ "AWS/SQS", "ApproximateNumberOfMessagesVisible", "QueueName", "${sqs_high_priority}", { "region": "${aws_region}" } ]
                ]
            }
        },
        {
            "height": 6,
            "width": 6,
            "y": 15,
            "x": 6,
            "type": "metric",
            "properties": {
                "title": "Oldest message age (seconds)",
