                "stat": "Maximum",
                "period": 60,
                "metrics": [
                    [ "AWS/SQS", "ApproximateAgeOfOldestMessage", "QueueName", "${sqs_high_priority}", { "region": "${aws_region}" } ]
                ]
            }
        },
        {
            "height": 6,
            "width": 6,
            "y": 15,
            "x": 12,
            "type": "metric",
            "properties": {
                "title": "Messages sent / received",
                "view": "timeSeries",
                "stacked": false,
                "region": "${aws_region}",
                "stat": "Sum",
                "period": 60,
                "metrics": [
                    [ "AWS/SQS", "NumberOfMessagesSent", "QueueName", "${sqs_high_priority}", { "region": "${aws_region}", "color": "#0073BB", "label": "Sent" } ],
                    [ ".", "NumberOfMessagesReceived", ".", ".", { "region": "${aws_region}", "color": "#2CA02C", "label": "Received" } ]
                ]
            }
        },
