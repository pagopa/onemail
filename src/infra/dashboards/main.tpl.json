                "stat": "Maximum",
                "period": 60,
                "metrics": [
                    [ "AWS/SQS", "ApproximateNumberOfMessagesNotVisible", "QueueName", "${sqs_high_priority}", { "region": "${aws_region}" } ]
                ]
            }
