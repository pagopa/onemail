        {
            "height": 1,
            "width": 24,
            "y": 49,
            "x": 0,
            "type": "text",
            "properties": {
                "markdown": "## Email Outcome Status (SES)\n"
            }
        },
        {
            "height": 6,
            "width": 12,
            "y": 50,
            "x": 0,
            "type": "metric",
            "properties": {
                "view": "timeSeries",
                "stacked": true,
                "metrics": [
                    [ { "expression": "SUM(SEARCH('{${namespace},service,tenantName,clientId} MetricName=\"EmailDelivered\" service=\"${csp_service}\"', 'Sum', 300))", "label": "Delivered", "id": "e1", "region": "${aws_region}" } ],
                    [ { "expression": "SUM(SEARCH('{${namespace},service,tenantName,clientId} MetricName=\"EmailHardBounce\" service=\"${csp_service}\"', 'Sum', 300))", "label": "HardBounce", "id": "e2", "region": "${aws_region}" } ],
                    [ { "expression": "SUM(SEARCH('{${namespace},service,tenantName,clientId} MetricName=\"EmailRejected\" service=\"${csp_service}\"', 'Sum', 300))", "label": "Rejected", "id": "e3", "region": "${aws_region}" } ],
                    [ { "expression": "SUM(SEARCH('{${namespace},service,tenantName,clientId} MetricName=\"EmailRenderingFailure\" service=\"${csp_service}\"', 'Sum', 300))", "label": "RenderingFailure", "id": "e4", "region": "${aws_region}" } ],
                    [ { "expression": "SUM(SEARCH('{${namespace},service,tenantName,clientId} MetricName=\"EmailComplaint\" service=\"${csp_service}\"', 'Sum', 300))", "label": "Complaint", "id": "e5", "region": "${aws_region}" } ]
                ],
                "region": "${aws_region}",
                "period": 300,
                "title": "Delivery vs Failures (all tenants)"
            }
        },
        {
            "height": 6,
            "width": 12,
            "y": 50,
            "x": 12,
            "type": "metric",
            "properties": {
                "view": "timeSeries",
                "stacked": false,
                "metrics": [
                    [ { "expression": "SUM(SEARCH('{${namespace},service,tenantName,clientId} MetricName=\"EmailNonRetryableSoftBounce\" service=\"${csp_service}\"', 'Sum', 300))", "label": "NonRetryableSoftBounce", "id": "e1", "region": "${aws_region}" } ],
                    [ { "expression": "SUM(SEARCH('{${namespace},service,attempt} MetricName=\"HighPriorityRetry\" service=\"${csp_service}\"', 'Sum', 300))", "label": "HighPriorityRetry", "id": "e2", "region": "${aws_region}" } ],
                    [ { "expression": "SUM(SEARCH('{${namespace},service,attempt} MetricName=\"LowPriorityRetry\" service=\"${csp_service}\"', 'Sum', 300))", "label": "LowPriorityRetry", "id": "e3", "region": "${aws_region}" } ]
                ],
                "region": "${aws_region}",
                "period": 300,
                "title": "Non-Retryable Soft Bounce & Retry Attempts (all tenants)"
            }
        },
        {
            "height": 6,
            "width": 6,
            "y": 56,
            "x": 0,
            "type": "metric",
            "properties": {
                "view": "timeSeries",
                "stacked": false,
                "metrics": [
                    [ { "expression": "SUM(SEARCH('{${namespace},service,tenantName,clientId} MetricName=\"HighPriorityMaxRetriesReached\" service=\"${csp_service}\"', 'Sum', 300))", "label": "HighPriority", "id": "e1", "region": "${aws_region}" } ],
                    [ { "expression": "SUM(SEARCH('{${namespace},service,tenantName,clientId} MetricName=\"LowPriorityMaxRetriesReached\" service=\"${csp_service}\"', 'Sum', 300))", "label": "LowPriority", "id": "e2", "region": "${aws_region}" } ]
                ],
                "region": "${aws_region}",
                "period": 300,
                "title": "Retry Exhausted (all tenants)"
            }
        },
