{
    "widgets": [
        {
            "height": 1,
            "width": 24,
            "y": 0,
            "x": 0,
            "type": "text",
            "properties": {
                "markdown": "## Sender\n"
            }
        },
        {
            "height": 6,
            "width": 8,
            "y": 1,
            "x": 0,
            "type": "metric",
            "properties": {
                "view": "timeSeries",
                "stacked": true,
                "metrics": [
                    [ "${namespace}", "HighPriorityDispatched", "service", "${sender_service}", { "region": "${aws_region}", "label": "HighPriority" } ],
                    [ ".", "LowPriorityDispatched", ".", ".", { "region": "${aws_region}", "label": "LowPriority" } ]
                ],
                "region": "${aws_region}",
                "period": 300,
                "stat": "Sum",
                "title": "Send Throughput"
            }
        },
        {
            "height": 6,
            "width": 8,
            "y": 1,
            "x": 8,
            "type": "metric",
            "properties": {
                "view": "timeSeries",
                "stacked": false,
                "metrics": [
                    [ "${namespace}", "HighPriorityRejected", "service", "${sender_service}", { "region": "${aws_region}", "label": "HighPriorityRejected" } ],
                    [ ".", "LowPriorityRejected", ".", ".", { "region": "${aws_region}", "label": "LowPriorityRejected" } ]
                ],
                "region": "${aws_region}",
                "period": 300,
                "stat": "Sum",
                "title": "SES Rejections"
            }
        },
        {
            "height": 6,
            "width": 8,
            "y": 1,
            "x": 16,
            "type": "metric",
            "properties": {
                "view": "singleValue",
                "metrics": [
                    [ "${namespace}", "HighPriorityExhaustedRetries", "service", "${sender_service}", { "region": "${aws_region}", "label": "HighPriority" } ],
                    [ ".", "LowPriorityExhaustedRetries", ".", ".", { "region": "${aws_region}", "label": "LowPriority" } ]
                ],
                "region": "${aws_region}",
                "period": 300,
                "stat": "Sum",
                "title": "Sender Exhausted Retries"
            }
        },
        {
            "height": 1,
            "width": 24,
            "y": 7,
            "x": 0,
            "type": "text",
            "properties": {
                "markdown": "## Dispatcher\n"
            }
        },
        {
            "height": 6,
            "width": 12,
            "y": 8,
            "x": 0,
            "type": "metric",
            "properties": {
                "view": "timeSeries",
                "stacked": true,
                "metrics": [
                    [ { "expression": "SEARCH('{${namespace},service,tenantName} MetricName=\"HighPriorityAccepted\" service=\"${dispatcher_service}\"', 'Sum', 300)", "id": "hp", "label": "HighPriority" } ],
                    [ { "expression": "SEARCH('{${namespace},service,tenantName} MetricName=\"LowPriorityAccepted\" service=\"${dispatcher_service}\"', 'Sum', 300)", "id": "lp", "label": "LowPriority" } ]
                ],
                "region": "${aws_region}",
                "period": 300,
                "stat": "Sum",
                "title": "Accepted Requests"
            }
        }
    ]
}
