{
  "openapi": "3.0.0",
  "info": {
    "title": "OneMail API",
    "version": "1.0.0",
    "description": "OneMail REST API"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check endpoint",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        },
        "x-amazon-apigateway-integration": {
          "type": "MOCK",
          "responses": {
            "default": {
              "statusCode": "200",
              "responseTemplates": {
                "application/json": "{\"status\": \"ok\"}"
              }
            }
          }
        }
      }
    }
  }
}