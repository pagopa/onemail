{
  "openapi": "3.0.0",
  "info": {
    "title": "OneMail Dispatcher API",
    "version": "1.5.9",
    "description": "Service that manages the orchestration and dispatching of high-volume email queues.",
    "contact": {
      "email": "team-one-mail@pagopa.it"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "servers": [
    {
      "url": "${server_url}"
    }
  ],
  "paths": {
    "/v1/emails/statuses": {
      "get": {
        "tags": ["Emails"],
        "summary": "Get email status history",
        "parameters": [
          {
            "name": "requestId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "x-amazon-apigateway-integration": {
          "type": "HTTP_PROXY",
          "httpMethod": "GET",
          "uri": "${uri}/v1/emails/statuses",
          "connectionType": "VPC_LINK",
          "connectionId": "${connection_id}",
          "passthroughBehavior": "WHEN_NO_TEMPLATES",
          "timeoutInMillis": 20000
        },
        "responses": {
          "200": { "description": "Email status history retrieved successfully" },
          "400": { "description": "Bad request - invalid data" },
          "401": { "description": "Unauthorized - authentication required or invalid credentials" },
          "403": { "description": "Forbidden - permission denied to perform the request" },
          "404": { "description": "Resource not found" },
          "500": { "description": "Generic error" }
        }
      }
    },
    "/v1/emails/send/high": {
      "post": {
        "tags": ["Emails"],
        "summary": "Send high priority single email",
        "parameters": [
          %{ if env != "prod" }
            {
              "name": "dryRun",
              "in": "query",
              "required": false,
              "schema": {
                "type": "boolean",
                "default": false
              }
            }
          %{ endif }
        ],
        "x-amazon-apigateway-integration": {
          "type": "HTTP_PROXY",
          "httpMethod": "POST",
          "uri": "${uri}/v1/emails/send/high",
          "connectionType": "VPC_LINK",
          "connectionId": "${connection_id}",
          "passthroughBehavior": "WHEN_NO_TEMPLATES",
          "timeoutInMillis": 20000
        },
        "responses": {
          "202": { "description": "Email accepted for processing" },
          "400": { "description": "Bad request - invalid data" },
          "401": { "description": "Unauthorized - authentication required or invalid credentials" },
          "403": { "description": "Forbidden - permission denied to perform the request" },
          "404": { "description": "Resource not found" },
          "500": { "description": "Generic error" }
        }
      }
    },
    "/v1/emails/send/low": {
      "post": {
        "tags": ["Emails"],
        "summary": "Send low priority email with single or multiple recipients",
        "parameters": [
          %{ if env != "prod" }
            {
              "name": "dryRun",
              "in": "query",
              "required": false,
              "schema": {
                "type": "boolean",
                "default": false
              }
            }
          %{ endif }
        ],
        "x-amazon-apigateway-integration": {
          "type": "HTTP_PROXY",
          "httpMethod": "POST",
          "uri": "${uri}/v1/emails/send/low",
          "connectionType": "VPC_LINK",
          "connectionId": "${connection_id}",
          "passthroughBehavior": "WHEN_NO_TEMPLATES",
          "timeoutInMillis": 20000
        },
        "responses": {
          "202": { "description": "Email accepted for processing" },
          "400": { "description": "Bad request - invalid data" },
          "401": { "description": "Unauthorized - authentication required or invalid credentials" },
          "403": { "description": "Forbidden - permission denied to perform the request" },
          "404": { "description": "Resource not found" },
          "500": { "description": "Generic error" }
        }
      }
    },
    %{ if env != "prod" }
      "/v1/emails/sanitize-html": {
        "post": {
          "tags": ["Emails"],
          "summary": "Test HTML content sanitization of the email, only available in non-production environments",
          "x-amazon-apigateway-integration": {
            "type": "HTTP_PROXY",
            "httpMethod": "POST",
            "uri": "${uri}/v1/emails/sanitize-html",
            "connectionType": "VPC_LINK",
            "connectionId": "${connection_id}",
            "passthroughBehavior": "WHEN_NO_TEMPLATES",
            "timeoutInMillis": 20000
          },
          "responses": {
            "200": { "description": "Email sanitized successfully" },
            "400": { "description": "Bad request - invalid data" },
            "401": { "description": "Unauthorized - authentication required or invalid credentials" },
            "403": { "description": "Forbidden - permission denied to perform the request" },
            "404": { "description": "Resource not found" },
            "500": { "description": "Generic error" }
          }
        }
      },
    %{ endif }
    "/health/ready": {
      "get": {
        "tags": ["Health"],
        "summary": "Perform readiness check of the service",
        "x-amazon-apigateway-integration": {
          "type": "HTTP_PROXY",
          "httpMethod": "GET",
          "uri": "${uri}/health/ready",
          "connectionType": "VPC_LINK",
          "connectionId": "${connection_id}",
          "passthroughBehavior": "WHEN_NO_TEMPLATES",
          "timeoutInMillis": 5000
        },
        "responses": {
          "200": { "description": "Service is ready" },
          "400": { "description": "Bad request - invalid data" },
          "401": { "description": "Unauthorized - authentication required or invalid credentials" },
          "403": { "description": "Forbidden - permission denied to perform the request" },
          "404": { "description": "Resource not found" },
          "500": { "description": "Generic error" }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Perform liveness check of the service",
        "x-amazon-apigateway-integration": {
          "type": "HTTP_PROXY",
          "httpMethod": "GET",
          "uri": "${uri}/health",
          "connectionType": "VPC_LINK",
          "connectionId": "${connection_id}",
          "passthroughBehavior": "WHEN_NO_TEMPLATES",
          "timeoutInMillis": 5000
        },
        "responses": {
          "200": { "description": "Service is alive" },
          "400": { "description": "Bad request - invalid data" },
          "401": { "description": "Unauthorized - authentication required or invalid credentials" },
          "403": { "description": "Forbidden - permission denied to perform the request" },
          "404": { "description": "Resource not found" },
          "500": { "description": "Generic error" }
        }
      }
    }
  }
}
