{
  "name": "om-common",
  "version": "1.4.0",
  "description": "Shared types and utilities for OneMail services",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "lint:check": "eslint",
    "lint": "eslint --fix",
    "format:check": "prettier --check '**/*.{ts,js,mjs,json,yml,yaml}' --ignore-path ../../../.prettierignore",
    "format": "prettier --write '**/*.{ts,js,mjs,json,yml,yaml}' --ignore-path ../../../.prettierignore"
  },
  "exports": {
    "./repositories": {
      "local": "./src/repositories/index.ts",
      "types": "./dist/repositories/index.d.ts",
      "default": "./dist/repositories/index.js"
    },
    "./types": {
      "local": "./src/types/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./utils": {
      "local": "./src/utils/index.ts",
      "types": "./dist/utils/index.d.ts",
      "default": "./dist/utils/index.js"
    },
    "./logger": {
      "local": "./src/logger/index.ts",
      "types": "./dist/logger/index.d.ts",
      "default": "./dist/logger/index.js"
    }
  },
  "homepage": "https://github.com/pagopa/onemail/blob/main/src/onemail/om-common/README.md",
  "dependencies": {
    "@aws-lambda-powertools/logger": "catalog:aws-lambda",
    "@aws-lambda-powertools/metrics": "catalog:aws-lambda"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@aws-lambda-powertools/commons": "catalog:aws-lambda"
  }
}
