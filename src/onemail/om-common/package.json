{
  "name": "om-common",
  "version": "1.0.1",
  "description": "Shared types and utilities for OneMail services",
  "private": true,
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "lint:check": "eslint",
    "lint": "eslint --fix",
    "format:check": "prettier --check '**/*.{ts,js,mjs,json,yml,yaml}'",
    "format": "prettier --write '**/*.{ts,js,mjs,json,yml,yaml}'"
  },
  "exports": {
    "./types": {
      "local": "./src/types/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    }
  },
  "devDependencies": {},
  "homepage": "https://github.com/pagopa/onemail/blob/main/src/onemail/common/README.md"
}
