{
  "name": "om-lambda-sender",
  "version": "1.0.2",
  "description": "Lambda that sends email requests to SES.",
  "private": true,
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "echo \"No dev start yet for sender\"",
    "build": "tsc --build tsconfig.build.json",
    "test": "echo \"No tests yet for sender\"",
    "type-check": "tsc --noEmit",
    "lint:check": "eslint",
    "lint": "eslint --fix",
    "format:check": "prettier --check '**/*.{ts,js,mjs,json,yml,yaml}'",
    "format": "prettier --write '**/*.{ts,js,mjs,json,yml,yaml}'"
  },
  "dependencies": {
    "@aws-lambda-powertools/batch": "^2.31.0",
    "@aws-lambda-powertools/logger": "^2.31.0",
    "aws-lambda": "^1.0.7",
    "om-common": "workspace:*"
  },
  "imports": {
    "#*": {
      "local": "./src/*.js",
      "default": "./dist/*.js"
    }
  },
  "homepage": "https://github.com/pagopa/onemail/blob/main/src/onemail/om-lambda-sender/README.md",
  "devDependencies": {
    "@types/aws-lambda": "^8.10.160",
    "@types/node": "^24.10.12"
  }
}
