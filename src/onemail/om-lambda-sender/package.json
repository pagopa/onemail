{
  "name": "om-lambda-sender",
  "version": "1.3.2",
  "description": "Lambda that sends email requests to SES.",
  "private": true,
  "main": "dist/app.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/app.js",
    "dev": "echo \"No dev start yet for sender\"",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint:check": "eslint",
    "lint": "eslint --fix",
    "format:check": "prettier --check '**/*.{ts,js,mjs,json,yml,yaml}' --ignore-path ../../../.prettierignore",
    "format": "prettier --write '**/*.{ts,js,mjs,json,yml,yaml}' --ignore-path ../../../.prettierignore"
  },
  "dependencies": {
    "@aws-lambda-powertools/batch": "catalog:aws-lambda",
    "@aws-sdk/client-dynamodb": "catalog:aws-sdk",
    "@aws-sdk/client-sesv2": "catalog:aws-sdk",
    "@aws-sdk/lib-dynamodb": "catalog:aws-sdk",
    "@middy/core": "catalog:",
    "lodash-es": "catalog:",
    "om-common": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/aws-lambda": "catalog:aws-lambda",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "aws-lambda": "catalog:aws-lambda"
  },
  "imports": {
    "#*": {
      "local": "./src/*.js",
      "default": "./dist/*.js"
    }
  },
  "homepage": "https://github.com/pagopa/onemail/blob/main/src/onemail/om-lambda-sender/README.md"
}
