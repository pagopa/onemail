  "version": "1.0.0",
  "description": "Lambda that sends email requests to SES.",
  "main": "dist/app.js",
  "type": "module",
  "scripts": {
    "start": "node dist/app.js",
    "dev": "",
    "build": "tsc && tsc-alias",
    "test": "",
    "type-check": "tsc --noEmit",
    "lint:check": "eslint",
