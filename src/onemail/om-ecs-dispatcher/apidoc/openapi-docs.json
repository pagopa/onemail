{
  "openapi": "3.0.0",
  "info": {
    "title": "OneMail Dispatcher API",
    "version": "1.4.0",
    "description": "Service that manages the orchestration and dispatching of high-volume email queues.",
    "contact": {
      "email": "team-one-mail@pagopa.it"
    },
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    }
  },
  "servers": [
    {
      "url": "${server_url}"
    }
  ],
  "components": {
    "schemas": {
      "EmailStatusItemDTO": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "Delivered",
              "Dispatched",
              "HardBounce",
              "Queued",
              "RejectedBySES",
              "SoftBounce"
            ],
            "description": "Current status of the email"
          },
          "priority": {
            "type": "string",
            "enum": [
              "HIGH",
              "LOW"
            ],
            "description": "Priority of the tracked email request"
          },
          "to": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "description": "Name associated with the email address"
              },
              "email": {
                "type": "string",
                "format": "email",
                "description": "Email address"
              }
            },
            "required": [
              "email"
            ],
            "description": "Recipient email address"
          },
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "Delivered",
                    "Dispatched",
                    "HardBounce",
                    "Queued",
                    "RejectedBySES",
                    "SoftBounce"
                  ],
                  "description": "Status value at this point in time"
                },
                "changedAt": {
                  "type": "string",
                  "format": "date-time",
                  "description": "ISO 8601 timestamp of the status change event"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "description": "Optional detail or reason for the status change"
                }
              },
              "required": [
                "status",
                "changedAt"
              ],
              "description": "Single history event for the email status"
            },
            "description": "Chronological history of status changes"
          }
        },
        "required": [
          "status",
          "priority",
          "to",
          "history"
        ]
      },
      "EmailHighPriorityResponseDTO": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Unique identifier for the request, used for checking the status of the emails in the system"
          }
        },
        "required": [
          "requestId"
        ]
      },
      "EmailHighPriorityBodyDTO": {
        "allOf": [
          {
            "type": "object",
            "properties": {
              "from": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "description": "Name associated with the email address"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email address"
                  }
                },
                "required": [
                  "email"
                ],
                "description": "Sender of the email"
              },
              "to": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255,
                    "description": "Name associated with the email address"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "description": "Email address"
                  }
                },
                "required": [
                  "email"
                ],
                "description": "Recipient of the email"
              },
              "extendedHeaders": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "N": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255,
                      "description": "Key"
                    },
                    "V": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255,
                      "description": "Value"
                    }
                  },
                  "required": [
                    "N",
                    "V"
                  ]
                },
                "description": "Custom headers for the email"
              },
              "tag": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255
                },
                "description": "Custom tags/categories for the email"
              }
            },
            "required": [
              "from",
              "to"
            ]
          },
          {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "templateContent": {
                    "type": "object",
                    "properties": {
                      "templateId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255,
                        "description": "Identifier of the email template"
                      },
                      "templateAttributes": {
                        "type": "object",
                        "additionalProperties": {
                          "nullable": true,
                          "description": "Value"
                        },
                        "description": "Dynamic attributes for template rendering"
                      }
                    },
                    "required": [
                      "templateId"
                    ],
                    "description": "Template content of the email to be sent if emailContent is not provided"
                  }
                },
                "required": [
                  "templateContent"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "emailContent": {
                    "type": "object",
                    "properties": {
                      "subject": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255,
                        "description": "Subject of the email"
                      },
                      "html": {
                        "type": "string",
                        "minLength": 10,
                        "maxLength": 200000,
                        "description": "HTML content of the email"
                      },
                      "text": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200000,
                        "description": "Text content of the email used as fallback if HTML content is not supported by the email client"
                      }
                    },
                    "required": [
                      "subject",
                      "html"
                    ],
                    "description": "Content of the email to be sent if templateContent is not provided"
                  }
                },
                "required": [
                  "emailContent"
                ]
              }
            ]
          }
        ]
      },
      "EmailLowPriorityResponseDTO": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Unique identifier for the request, used for checking the status of the emails in the system"
          }
        },
        "required": [
          "requestId"
        ]
      },
      "EmailLowPriorityBodyDTO": {
        "type": "object",
        "properties": {
          "from": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "description": "Name associated with the email address"
              },
              "email": {
                "type": "string",
                "format": "email",
                "description": "Email address"
              }
            },
            "required": [
              "email"
            ],
            "description": "Sender of the email"
          },
          "tag": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "description": "Custom tags/categories for the email"
          },
          "replyTo": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "description": "Name associated with the email address"
              },
              "email": {
                "type": "string",
                "format": "email",
                "description": "Email address"
              }
            },
            "required": [
              "email"
            ],
            "description": "Reply-to address for the email"
          },
          "templateId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Identifier of the email template"
          },
          "sendingInfo": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "to": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 255,
                      "description": "Name associated with the email address"
                    },
                    "email": {
                      "type": "string",
                      "format": "email",
                      "description": "Email address"
                    }
                  },
                  "required": [
                    "email"
                  ],
                  "description": "Recipient of the email"
                },
                "extendedHeaders": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "N": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255,
                        "description": "Key"
                      },
                      "V": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 255,
                        "description": "Value"
                      }
                    },
                    "required": [
                      "N",
                      "V"
                    ]
                  },
                  "description": "Custom headers for the email"
                },
                "templateAttributes": {
                  "type": "object",
                  "additionalProperties": {
                    "nullable": true,
                    "description": "Value"
                  },
                  "description": "Dynamic attributes for template rendering"
                }
              },
              "required": [
                "to"
              ]
            },
            "maxItems": 50,
            "description": "Information about the recipients and their template email content"
          }
        },
        "required": [
          "from",
          "templateId",
          "sendingInfo"
        ]
      },
      "SanitizeHtmlResponseDTO": {
        "type": "object",
        "properties": {
          "sanitizedHtml": {
            "type": "string",
            "description": "Sanitized HTML content"
          }
        },
        "required": [
          "sanitizedHtml"
        ]
      },
      "SanitizeHtmlDTO": {
        "type": "object",
        "properties": {
          "htmlContent": {
            "type": "string",
            "minLength": 10,
            "maxLength": 200000,
            "description": "HTML content to be sanitized",
            "example": "<p>Hello <strong>World</strong></p>"
          }
        },
        "required": [
          "htmlContent"
        ]
      },
      "HealthResponseDTO": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "Healthy",
              "Unhealthy"
            ],
            "description": "Overall health status of the service"
          },
          "timestamp": {
            "type": "string",
            "description": "Timestamp of the health check"
          },
          "services": {
            "type": "object",
            "properties": {
              "db": {
                "type": "string",
                "enum": [
                  "Initialized",
                  "NotInitialized",
                  "Unavailable"
                ],
                "description": "Status of the DynamoDB service"
              }
            },
            "required": [
              "db"
            ],
            "description": "Status of individual services"
          },
          "uptime": {
            "type": "number",
            "description": "Uptime of the service in seconds"
          }
        },
        "required": [
          "status",
          "timestamp",
          "services",
          "uptime"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/emails/statuses": {
      "get": {
        "tags": [
          "Emails"
        ],
        "summary": "Get emails status",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255,
              "description": "Unique identifier for the request, used for checking the status of the emails in the system"
            },
            "required": true,
            "description": "Unique identifier for the request, used for checking the status of the emails in the system",
            "name": "requestId",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Emails status retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
