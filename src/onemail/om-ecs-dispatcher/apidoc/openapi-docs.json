    "/v1/emails/sanitize-html": {
      "post": {
        "tags": [
          "Emails"
        ],
        "summary": "Sanitize HTML content of the email",
        "requestBody": {
          "description": "Request body",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SanitizeHtmlDTO"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Email accepted for processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SanitizeHtmlResponseDTO"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - invalid data |",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "description": "Error message"
                    },
