{
  "name": "om-ecs-dispatcher",
  "version": "1.7.0",
  "description": "RESTful API that sorts requests into queues based on priority",
  "private": true,
  "main": "dist/app.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/app.js",
    "dev": "tsx watch -C local src/app.ts",
    "build": "tsc -p tsconfig.build.json",
    "generate:openapi": "tsx -C local scripts/generateOpenapi.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint:check": "eslint",
    "lint": "eslint --fix",
    "format:check": "prettier --check '**/*.{ts,js,mjs,json,yml,yaml}' --ignore-path ../../../.prettierignore",
    "format": "prettier --write '**/*.{ts,js,mjs,json,yml,yaml}' --ignore-path ../../../.prettierignore"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.4.1",
    "@aws-sdk/client-dynamodb": "catalog:aws-sdk",
    "@aws-sdk/client-sqs": "catalog:aws-sdk",
    "@aws-sdk/lib-dynamodb": "catalog:aws-sdk",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "http-status-codes": "^2.3.0",
    "lodash-es": "catalog:",
    "om-common": "workspace:*",
    "sanitize-html": "^2.17.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/sanitize-html": "^2.16.0",
    "@types/swagger-ui-express": "^4.1.8",
    "tsx": "^4.21.0"
  },
  "imports": {
    "#*": {
      "local": "./src/*.js",
      "default": "./dist/*.js"
    }
  },
  "homepage": "https://github.com/pagopa/onemail/blob/main/src/onemail/om-ecs-dispatcher/README.md"
}
