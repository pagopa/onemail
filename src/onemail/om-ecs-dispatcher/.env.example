PORT=3000
HOST='http://localhost:3000'
APP_ENV='local' # local | development | production | uat
AWS_REGION='eu-south-1'
AWS_EMAIL_DB_TABLE='EmailStatusHistory'
AWS_EMAIL_DB_REQUEST_ID_GSI='gsi_request_id_idx'
AWS_TENANT_CONFIG_TABLE='TenantConfig'
AWS_TENANT_DB_CONFIG_TENANT_NAME_GSI='gsi_tenant_name_idx'

# local development with dynamodb
AWS_DYNAMODB_ENDPOINT='http://localhost:8000'
AWS_DYNAMODB_ACCESS_KEY_ID='local'
AWS_DYNAMODB_SECRET_ACCESS_KEY='local'

# SQS
SQS_HIGH_PRIORITY_QUEUE_URL="test-url.test"
SQS_LOW_PRIORITY_QUEUE_URL="test-url.test"

# Metrics
SERVICE_PREFIX='ecs'
AWS_CLOUDWATCH_METRICS_NAMESPACE='namespace'
