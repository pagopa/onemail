{
  "name": "onemail",
  "version": "1.4.7",
  "description": "Centralized email service for PagoPA products.",
  "packageManager": "pnpm@10.29.2",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=!onemail",
    "build": "turbo run build --filter=!onemail",
    "dev:dispatcher": "turbo run dev --filter=om-ecs-dispatcher",
    "dev:sender": "turbo run dev --filter=om-lambda-sender",
    "dev:config-set-processor": "turbo run dev --filter=om-lambda-config-set-processor",
    "build:dispatcher": "turbo run build --filter=om-ecs-dispatcher",
    "build:sender": "turbo run build --filter=om-lambda-sender",
    "build:config-set-processor": "turbo run build --filter=om-lambda-config-set-processor",
    "package:dispatcher": "pnpm --filter=om-ecs-dispatcher deploy --prod --config.inject-workspace-packages=true dist-artifact/om-ecs-dispatcher",
    "package:sender": "bash scripts/package-sender.sh",
    "package:config-set-processor": "bash scripts/package-config-set-processor.sh",
    "type-check": "turbo run type-check --filter=!onemail",
    "lint:check": "turbo run lint:check --filter=!onemail",
    "lint": "turbo run lint --filter=!onemail",
    "format:check": "turbo run format:check --filter=!onemail",
    "format": "turbo run format --filter=!onemail",
    "setup:hooks": "bash ./scripts/setup-pre-commit-hooks.sh",
    "generate:openapi": "pnpm --filter=om-ecs-dispatcher generate:openapi",
    "sync:openapi-template": "pnpm run generate:openapi && bash scripts/syncOpenapiTemplateAI.sh",
    "version": "pnpm changeset version && pnpm install --lockfile-only",
    "test": "turbo run test --filter=!onemail",
    "test:watch": "turbo run test:watch --parallel --filter=!onemail",
    "test:coverage": "turbo run test:coverage --filter=!onemail",
    "test:dispatcher": "turbo run test --filter=om-ecs-dispatcher",
    "test:sender": "turbo run test --filter=om-lambda-sender",
    "test:config-set-processor": "turbo run test --filter=om-lambda-config-set-processor"
  },
  "dependencies": {
    "infra-core": "workspace:*",
    "infra-domains-onemail-app": "workspace:*",
    "infra-domains-onemail-common": "workspace:*",
    "infra-domains-onemail-monitoring": "workspace:*",
    "infra-iam": "workspace:*",
    "infra-network": "workspace:*",
    "infra-security": "workspace:*",
    "om-common": "workspace:*",
    "om-ecs-dispatcher": "workspace:*",
    "om-lambda-config-set-processor": "workspace:*",
    "om-lambda-sender": "workspace:*"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@pagopa/eslint-config": "^5.1.2",
    "@vitest/coverage-v8": "catalog:vitest",
    "eslint": "^10.0.0",
    "prettier": "^3.8.1",
    "turbo": "^2.8.12",
    "typescript": "^5.9.3",
    "vitest": "catalog:vitest"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:pagopa/onemail.git"
  },
  "author": "PagoPa (https://github.com/pagopa)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pagopa/onemail/issues"
  },
  "homepage": "https://github.com/pagopa/onemail#readme",
  "pnpm": {
    "overrides": {
      "path-to-regexp": ">=8.4.0",
      "yaml": ">=2.8.3",
      "qs": ">=6.14.2"
    }
  }
}
