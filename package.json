{
  "name": "onemail",
  "version": "1.0.0",
  "description": "Centralized email service for PagoPA products.",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev:dispatcher": "pnpm --silent --filter om-ecs-dispatcher dev --no-bail",
    "dev:sender": "pnpm --silent --filter om-lambda-sender dev",
    "build:dispatcher": "pnpm --filter om-ecs-dispatcher build",
    "build:sender": "pnpm --filter om-lambda-sender build",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/onemail",
    "lint:fix": "eslint --fix src/onemail",
    "format": "prettier --write 'src/onemail/**/*.{ts,js,mjs,json,yml,yaml}'"
  },
  "dependencies": {
    "lodash": "^4.17.23",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pagopa/eslint-config": "^5.1.2",
    "@types/lodash": "^4.17.23",
    "@types/node": "^24.10.12",
    "eslint": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:pagopa/onemail.git"
  },
  "author": "PagoPa (https://github.com/pagopa)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/pagopa/onemail/issues"
  },
  "homepage": "https://github.com/pagopa/onemail#readme"
}
